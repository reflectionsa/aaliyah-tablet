{
  "version": 3,
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "MinGW-w64 (Linux, macOS, MSYS2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "toolchainFile": "${sourceDir}/cmake/mingw-toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc",
      "displayName": "MSVC x64 (Developer prompt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "msvc", "configurePreset": "msvc" }
  ]
}
